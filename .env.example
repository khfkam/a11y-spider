# Scan behavior — A, AA, or AAA (default: AA)
AXE_LEVEL=AA
PAGE_WAIT_STRATEGY=networkidle
PAGE_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000
CONCURRENCY=1

# URL validation
ALLOW_HTTP=false

# History
HISTORY_DIR=./history
HISTORY_RETENTION_DAYS=90
HISTORY_MAX_FILES=100

# Output
REPORTS_DIR=./reports
FAIL_ON=new
