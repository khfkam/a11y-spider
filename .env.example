# Scan behavior — A, AA, or AAA (default: AA)
AXE_LEVEL=AA
PAGE_WAIT_STRATEGY=networkidle
PAGE_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000
CONCURRENCY=1

# URL validation
ALLOW_HTTP=false

# Cookie / consent banners (fail-soft — scan continues if nothing matches)
CONSENT_DISMISS=true
CONSENT_SELECTORS_FILE=./consent-selectors.json
CONSENT_DISMISS_TIMEOUT_MS=2500
CONSENT_SETTLE_MS=500
# Optional comma-separated Playwright selectors appended after the JSON file
# CONSENT_EXTRA_SELECTORS=#my-site-accept,button:has-text("I agree")

# History
HISTORY_DIR=./history
HISTORY_RETENTION_DAYS=90
HISTORY_MAX_FILES=100

# Output
REPORTS_DIR=./reports
FAIL_ON=new
